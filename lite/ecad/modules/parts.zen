"""Part instantiation helper for the Lite flight controller.

`place()` instantiates modules/placed.zen so that the part keeps `name` as its
reference designator (pcb only honours a refdes-like name on a module instance;
see placed.zen). Symbols and footprints come from lib/ (generated by
lib/gen_lib.py, mill-friendly pads).
"""


def place(placed, name, symbol, footprint, pins, prefix="U", mpn="", manufacturer="", value="", kind="", in_bom=True):
    kinds = {"Power": "p", "Ground": "g", "NotConnected": "x"}
    args = {"P" + str(i): net for i, net in enumerate(pins.values())}
    placed(
        name=name,
        symbol=symbol,
        footprint=footprint,
        prefix=prefix,
        mpn=mpn,
        manufacturer=manufacturer,
        value=value,
        kind=kind,
        in_bom=in_bom,
        pin_names="|".join(pins.keys()),
        pin_kinds="".join([kinds.get(net.type, "n") for net in pins.values()]),
        **args,
    )
