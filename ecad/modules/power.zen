"""Power tree (DESIGN.md section 3).

VBAT -> TVS -> LMR36015 buck -> 5V -> LDL1117 -> 3V3_D -> [DNP] TLV75512 -> 1V2_FPGA
                                 5V -> FB1 -> LP5907 -> 3V3_IMU
VBUS -> B5819W -> 5V

Datasheets used: TI SNVSB49D (LMR36015), ST DS12022 (LDL1117).
VERIFY (no datasheet reachable from the build container): LP5907, TLV755,
SMBJ26A, B5819W, SWPA4030S ratings quoted below are from memory.
"""

load("@stdlib/units.zen", "Capacitance", "Current", "Frequency", "Inductance", "Resistance", "Voltage")
load("./parts.zen", "C_100N", "C_10U", "C_1U", "C_20P", "C_220N_HV", "C_22U", "C_IN", "FERRITE", "R_100K", "R_24K9", "TEST_PAD")

Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")
FerriteBead = Module("@stdlib/generics/FerriteBead.zen")
Tvs = Module("@stdlib/generics/Tvs.zen")
TestPoint = Module("@stdlib/generics/TestPoint.zen")

# Battery range this tree is designed for: 2S minimum to 6S full (DESIGN.md section 3)
VBAT = io(Power(voltage="6V to 25.2V"), direction="input")
VBUS = io(Power(voltage="4.0V to 5.5V"), direction="input")

# Lower bound is LDL1117 VIN(min) 2.6 V + margin (DS12022 Table 4); upper bound
# is the LP5907 / TLV755 5.5 V input limit (VERIFY).
V5 = io(Power(voltage="3.8V to 5.5V"), direction="output")
V3V3_D = io(Power(voltage="3.0V to 3.6V"), direction="output")
V3V3_IMU = io(Power(voltage="3.0V to 3.6V"), direction="output")
V1V2_FPGA = io(Power(voltage="1.14V to 1.26V"), direction="output")
GND = io(Ground)

BUCK_SW = Net()
BUCK_BOOT = Net()
BUCK_FB = Net()
BUCK_VCC = Power(voltage="5V")
IMU_LDO_IN = Power(voltage=V5.voltage)

# --- design values ---
BUCK_VOUT = Voltage("5V")
BUCK_FSW = Frequency("1MHz")
BUCK_IOUT_MAX = Current("1.5A")
BUCK_L = Inductance("6.8uH")
R_FBT = Resistance("100k 1%")
R_FBB = Resistance("24.9k 1%")
TVS_STANDOFF = Voltage("26V")
TVS_CLAMP = Voltage("42.1V")  # SMBJ26A VC at IPP. VERIFY against Littelfuse datasheet


def buck_vout(v_ref, r_fbt, r_fbb):
    # SNVSB49D Equation 3: RFBB = RFBT / (VOUT / VREF - 1)  =>  VOUT = VREF * (1 + RFBT / RFBB)
    return v_ref * (1 + r_fbt / r_fbb)


def buck_ripple_factor(v_in, v_out, f_sw, l, i_out_max):
    # SNVSB49D Equation 4: L = (VIN - VOUT) / (fSW * K * IOUTmax) * VOUT / VIN, solved for K
    return (v_in - v_out) * v_out / (v_in * f_sw * l * i_out_max)


def buck_l_min(v_out, f_sw):
    # SNVSB49D Equation 5 (sub-harmonic limit): LMIN >= 0.28 * VOUT / fSW  [H, with V and Hz]
    return 0.28 * v_out / f_sw


# Feedback: VFB = 0.985 / 1 / 1.015 V (SNVSB49D section 8.5), 1 % resistors.
_vout_nom = buck_vout(1.0, R_FBT.nominal, R_FBB.nominal)
_vout_min = buck_vout(0.985, R_FBT.min, R_FBB.max)
_vout_max = buck_vout(1.015, R_FBT.max, R_FBB.min)
check(
    abs(_vout_nom - BUCK_VOUT.nominal) <= 0.02 * BUCK_VOUT.nominal,
    "buck nominal output {} V is not within 2 % of {}".format(_vout_nom, BUCK_VOUT),
)
check(
    _vout_min >= 4.75 and _vout_max <= 5.25,
    "buck output {}..{} V leaves 5 V +/-5 % over VFB and resistor tolerance".format(_vout_min, _vout_max),
)
check(_vout_max <= V5.voltage.max, "buck worst-case output exceeds the 5V rail limit")

# Inductor: ripple 20-40 % of the 1.5 A device rating at the highest steady-state
# VIN (SNVSB49D section 10.2.1.2.4), and above the sub-harmonic minimum.
_k = buck_ripple_factor(VBAT.voltage.max, BUCK_VOUT.nominal, BUCK_FSW.nominal, BUCK_L.nominal, BUCK_IOUT_MAX.nominal)
check(_k >= 0.2 and _k <= 0.4, "inductor ripple factor K = {} is outside the 0.2..0.4 window of SNVSB49D Eq. 4".format(_k))
check(
    BUCK_L.nominal >= buck_l_min(BUCK_VOUT.nominal, BUCK_FSW.nominal),
    "inductor is below LMIN of SNVSB49D Eq. 5",
)

# LMR36015 recommended operating VIN is 4.2-60 V (SNVSB49D section 8.3)
check(VBAT.voltage.min >= 4.2 and VBAT.voltage.max <= 60, "VBAT {} is outside the LMR36015 input range".format(VBAT.voltage))

# Input protection: the TVS must not conduct at a full 6S pack and must clamp
# below the LMR36015 absolute maximum VIN of 66 V (SNVSB49D section 8.1).
check(TVS_STANDOFF.nominal >= VBAT.voltage.max, "TVS standoff {} is below the maximum battery voltage {}".format(TVS_STANDOFF, VBAT.voltage))
check(TVS_CLAMP.nominal < 60, "TVS clamp voltage must stay below the LMR36015 60 V operating limit")

# --- VBAT input ---
Tvs(
    name="D3",
    package="DO-214AA",
    reverse_standoff_voltage=TVS_STANDOFF,
    reverse_clamping_voltage=TVS_CLAMP,
    mpn="SMBJ26A",
    manufacturer="Littelfuse",
    A=GND,
    K=VBAT,
)

# SNVSB49D section 10.2.1.2.6: >= 4.7 uF ceramic plus one 220 nF at each VIN/PGND pair.
BUCK_CIN_COUNT = 3
check(
    BUCK_CIN_COUNT * Capacitance(C_IN["value"]).nominal >= 4.7e-6,
    "buck input capacitance is below the 4.7 uF minimum",
)
for i in range(BUCK_CIN_COUNT):
    Capacitor(name="C_VBAT{}".format(i + 1), P1=VBAT, P2=GND, **C_IN)
Capacitor(name="C_VIN_HF1", P1=VBAT, P2=GND, **C_220N_HV)
Capacitor(name="C_VIN_HF2", P1=VBAT, P2=GND, **C_220N_HV)

# --- 5 V buck (U6) ---
# LMR36015FBRNXR: adjustable, 1 MHz, FPWM. bom.csv names LMR36015FSC5RNXR as a
# fixed-5 V part, but SNVSB49D lists adjustable RNX variants only, so the output
# is set with the datasheet divider. See check_design.py BOM_DIFFS.
Component(
    name="U6",
    symbol=Symbol(library="../lib/symbols/LMR36015.kicad_sym"),
    footprint=File("../lib/footprints/Texas_RNX0012C_VQFN-14-11-1EP_2x3mm_P0.5mm_EP0.25x1.825mm.kicad_mod"),
    part=Part(mpn="LMR36015FBRNXR", manufacturer="Texas Instruments"),
    pins={
        "VIN": VBAT,
        "EN": VBAT,  # "Can be connected directly to VIN; do not float"
        "VCC": BUCK_VCC,
        "AGND": GND,
        "PGND": GND,
        "BOOT": BUCK_BOOT,
        "SW": BUCK_SW,
        "NC": BUCK_SW,  # "Connect the SW pin to NC on the PCB"
        "FB": BUCK_FB,
        "PG": NotConnected(),  # "Can be open or grounded when not used"
    },
)
Capacitor(name="C_BOOT", P1=BUCK_BOOT, P2=BUCK_SW, **C_100N)  # 100 nF, >= 16 V
Capacitor(name="C_VCC", P1=BUCK_VCC, P2=GND, **C_1U)  # 1 uF, >= 16 V

# L1: 4030 shielded. bom.csv has 4.7 uH (K = 0.57 at 25.2 V); 6.8 uH meets Eq. 4.
# VERIFY: Isat of SWPA4030S6R8MT >= 2.07 A (LMR36015 low-side current limit, max).
Component(
    name="L1",
    prefix="L",
    symbol=Symbol(library="../lib/symbols/L_Small.kicad_sym"),
    footprint=File("../lib/footprints/L_Sunlord_SWPA4030S.kicad_mod"),
    part=Part(mpn="SWPA4030S6R8MT", manufacturer="Sunlord"),
    properties={"value": "6.8uH", "inductance": BUCK_L},
    type="inductor",
    pins={"1": BUCK_SW, "2": V5},
)

Resistor(name="R_FBT", P1=V5, P2=BUCK_FB, **(R_100K | {"value": R_FBT}))
Resistor(name="R_FBB", P1=BUCK_FB, P2=GND, **(R_24K9 | {"value": R_FBB}))
Capacitor(name="C_FF", P1=V5, P2=BUCK_FB, **C_20P)  # SNVSB49D Table 10-1: CFF 20 pF

# SNVSB49D Table 10-1, 1 MHz / 5 V: 3 x 15 uF nominal, 2 x 15 uF minimum.
BUCK_COUT_COUNT = 3
check(
    BUCK_COUT_COUNT * Capacitance(C_22U["value"]).nominal >= 2 * 15e-6,
    "buck output capacitance is below the 2 x 15 uF minimum",
)
for i in range(BUCK_COUT_COUNT):
    Capacitor(name="C_5V{}".format(i + 1), P1=V5, P2=GND, **C_22U)

TestPoint(name="TP8", variant=TEST_PAD, P1=BUCK_SW)

# --- USB VBUS OR-ing (D1) ---
# B5819W: 40 V, 1 A Schottky. VERIFY ratings against the Diodes Inc datasheet.
Component(
    name="D1",
    prefix="D",
    symbol=Symbol(library="../lib/symbols/D_Schottky_Small.kicad_sym"),
    footprint=File("../lib/footprints/D_SOD-123.kicad_mod"),
    part=Part(mpn="B5819W", manufacturer="Diodes Incorporated"),
    properties={"value": "B5819W"},
    type="rectifier",
    pins={"A": VBUS, "K": V5},
)

# --- 3V3_D: LDL1117S33R (U7) ---
# DS12022 section 6: CIN >= 1 uF, suggested 1 uF in / 4.7 uF out, ceramic.
LDO_D_IOUT_MAX = Current("0.43A")  # DESIGN.md section 3 budget
check(LDO_D_IOUT_MAX.nominal <= 1.2, "3V3_D load exceeds the LDL1117 1.2 A rating")
Component(
    name="U7",
    symbol=Symbol(library="../lib/symbols/LDL1117S33R.kicad_sym"),
    footprint=File("../lib/footprints/SOT-223-3_TabPin2.kicad_mod"),
    part=Part(mpn="LDL1117S33R", manufacturer="STMicroelectronics"),
    pins={"VIN": V5, "GND": GND, "VOUT": V3V3_D},
)
Capacitor(name="C_U7_IN", P1=V5, P2=GND, **C_1U)
Capacitor(name="C_U7_OUT", P1=V3V3_D, P2=GND, **C_10U)

# --- 3V3_IMU: FB1 + LP5907-3.3 (U8) ---
# DESIGN.md section 4: 1 uF + 10 uF at the LP5907 output. VERIFY: LP5907 needs
# >= 1 uF in and out and tolerates 10 uF more on the output.
FerriteBead(name="FB1", P1=V5, P2=IMU_LDO_IN, **FERRITE)
Component(
    name="U8",
    symbol=Symbol(library="../lib/symbols/LP5907MFX-3.3.kicad_sym", name="LP5907MFX-3.3"),
    footprint=File("../lib/footprints/SOT-23-5.kicad_mod"),
    part=Part(mpn="LP5907MFX-3.3/NOPB", manufacturer="Texas Instruments"),
    pins={"IN": IMU_LDO_IN, "EN": IMU_LDO_IN, "GND": GND, "OUT": V3V3_IMU},
)
Capacitor(name="C_U8_IN", P1=IMU_LDO_IN, P2=GND, **C_1U)
Capacitor(name="C_U8_OUT1", P1=V3V3_IMU, P2=GND, **C_1U)
Capacitor(name="C_U8_OUT2", P1=V3V3_IMU, P2=GND, **C_10U)

# --- 1V2_FPGA: TLV75512 (U11), DNP together with the FPGA ---
Component(
    name="U11",
    symbol=Symbol(library="../lib/symbols/TLV75512PDBV.kicad_sym", name="TLV75512PDBV"),
    footprint=File("../lib/footprints/SOT-23-5.kicad_mod"),
    part=Part(mpn="TLV75512PDBVR", manufacturer="Texas Instruments"),
    pins={"IN": V3V3_D, "EN": V3V3_D, "GND": GND, "OUT": V1V2_FPGA},
    dnp=True,
)
Capacitor(name="C_U11_IN", P1=V3V3_D, P2=GND, dnp=True, **C_1U)
Capacitor(name="C_U11_OUT", P1=V1V2_FPGA, P2=GND, dnp=True, **C_1U)
