"""W25N01GVZEIG 1 Gbit NAND (U5) on QUADSPI bank 1.

VERIFY: the Winbond datasheet was not reachable from the build container. The
pinout is the standard Winbond WSON-8 8x6 one (KiCad W25Q128JVE, cross-checked
with a vendor W25N01GVZEIG symbol): 1 /CS, 2 DO(IO1), 3 /WP(IO2), 4 GND,
5 DI(IO0), 6 CLK, 7 /HOLD(IO3), 8 VCC, exposed pad.
"""

load("@stdlib/interfaces.zen", "Qspi")
load("./parts.zen", "C_100N", "R_10K", "place")

Placed = Module("./placed.zen")
Resistor = Module("@stdlib/generics/Resistor.zen")
Capacitor = Module("@stdlib/generics/Capacitor.zen")

V3V3_D = io(Power(voltage="2.7V to 3.6V"))
GND = io(Ground)
QSPI = io(Qspi)

place(
    Placed,
    "U5",
    "W25N01GVZEIG",
    "WSON-8-1EP_8x6mm_P1.27mm_EP3.4x4.3mm",
    {
        "VCC": V3V3_D,
        "GND": GND,
        "EP": GND,
        "~{CS}": QSPI.CS,
        "CLK": QSPI.CLK,
        "DI/IO_{0}": QSPI.IO0,
        "DO/IO_{1}": QSPI.IO1,
        "~{WP}/IO_{2}": QSPI.IO2,
        "~{HOLD}/~{RESET}/IO_{3}": QSPI.IO3,
    },
    mpn="W25N01GVZEIG",
    manufacturer="Winbond",
)
Capacitor(name="C_U5_VCC", P1=V3V3_D, P2=GND, **C_100N)

# hw/pinmap.csv: 10k pull-ups on NCS, IO2 (/WP) and IO3 (/HOLD)
Resistor(name="R_NCS", P1=QSPI.CS, P2=V3V3_D, **R_10K)
Resistor(name="R_IO2", P1=QSPI.IO2, P2=V3V3_D, **R_10K)
Resistor(name="R_IO3", P1=QSPI.IO3, P2=V3V3_D, **R_10K)
